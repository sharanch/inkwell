{
  "title": "Inkwell — API Gateway RED",
  "uid": "inkwell-red",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["inkwell", "red", "gateway"],
  "templating": {
    "list": [
      {
        "name": "interval",
        "type": "interval",
        "label": "Interval",
        "current": { "value": "5m" },
        "options": [
          { "value": "1m" },
          { "value": "5m" },
          { "value": "10m" }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (rps)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "sum by (path) (rate(inkwell_gateway_requests_total[$interval]))",
          "legendFormat": "{{ path }}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.01, "color": "yellow" },
              { "value": 0.05, "color": "red" }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(inkwell_gateway_requests_total{status=~\"5..\"}[$interval])) / sum(rate(inkwell_gateway_requests_total[$interval]))",
          "legendFormat": "5xx error rate"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request Duration (p50 / p99)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(inkwell_gateway_request_duration_seconds_bucket[$interval])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(inkwell_gateway_request_duration_seconds_bucket[$interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "In-Flight Requests",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 20, "color": "yellow" },
              { "value": 50, "color": "red" }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "inkwell_gateway_requests_in_flight",
          "legendFormat": "in-flight"
        }
      ]
    },
    {
      "id": 5,
      "title": "Total Requests (window)",
      "type": "stat",
      "gridPos": { "x": 4, "y": 8, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "sum(increase(inkwell_gateway_requests_total[$interval]))",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 6,
      "title": "4xx Errors",
      "type": "stat",
      "gridPos": { "x": 8, "y": 8, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "yellow" }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(inkwell_gateway_requests_total{status=~\"4..\"}[$interval]))",
          "legendFormat": "4xx"
        }
      ]
    },
    {
      "id": 7,
      "title": "5xx Errors",
      "type": "stat",
      "gridPos": { "x": 12, "y": 8, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(inkwell_gateway_requests_total{status=~\"5..\"}[$interval]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 8,
      "title": "Request Rate by Status Code",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(inkwell_gateway_requests_total[$interval]))",
          "legendFormat": "{{ status }}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Latency by Path (p99)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, path) (rate(inkwell_gateway_request_duration_seconds_bucket[$interval])))",
          "legendFormat": "{{ path }}"
        }
      ]
    },
    {
      "id": 10,
      "title": "API Gateway Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{service=\"api-gateway\"}",
          "legendFormat": ""
        }
      ]
    }
  ]
}
